<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Emby 4.8/4.9 运行在 .NET 6 上 -->
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>Emby.SubtitleCat</AssemblyName>
        <RootNamespace>Emby.SubtitleCat</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>1.1.0.0</Version>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="TSCharacters.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" ExcludeAssets="runtime" />
        <PackageReference Include="MediaBrowser.Common" Version="4.9.1.90" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
