<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release;Debug.Emby;Release.Emby</Configurations>
        <RootNamespace>Emby.SubtitleCat</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>1.2.0.0</Version>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Jellyfin 10.11 运行在 .NET 9 上 -->
        <TargetFramework Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Release'">net9.0</TargetFramework>
        <!-- Emby 4.8/4.9 运行在 .NET 6 上 -->
        <TargetFramework Condition="'$(Configuration)'=='Debug.Emby' or '$(Configuration)'=='Release.Emby'">net6.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Release'">
        <AssemblyName>Jellyfin.SubtitleCat</AssemblyName>
        <DefineConstants>$(DefineConstants);JELLYFIN</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug.Emby' or '$(Configuration)'=='Release.Emby'">
        <AssemblyName>Emby.SubtitleCat</AssemblyName>
        <DefineConstants>$(DefineConstants);__EMBY__</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="TSCharacters.txt"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Release'">
        <PackageReference Include="Jellyfin.Controller" Version="10.11.0"/>
        <PackageReference Include="Jellyfin.Model" Version="10.11.0"/>
        <None Remove="Configuration\configPage.html"/>
        <EmbeddedResource Include="Configuration\configPage.html">
            <LogicalName>Emby.SubtitleCat.Configuration.configPage.html</LogicalName>
        </EmbeddedResource>
        <!-- 默认关闭字幕下载器的库级逻辑依赖 Emby 的媒体库编辑 API，Jellyfin 版不做该处理 -->
        <Compile Remove="LibraryDefaults.cs"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug.Emby' or '$(Configuration)'=='Release.Emby'">
        <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" ExcludeAssets="runtime"/>
        <PackageReference Include="MediaBrowser.Common" Version="4.9.1.90" ExcludeAssets="runtime"/>
    </ItemGroup>

    <Target Name="Zip" AfterTargets="PostBuildEvent" Condition="'$(Configuration)'=='Release' or '$(Configuration)'=='Release.Emby'">
        <ItemGroup>
            <FilesToDelete Include="$(BaseOutputPath)Jellyfin.SubtitleCat*.zip" Condition="'$(Configuration)'=='Release'"/>
            <FilesToDelete Include="$(BaseOutputPath)Emby.SubtitleCat*.zip" Condition="'$(Configuration)'=='Release.Emby'"/>
            <TempZipDirectory Include="$(OutputPath)output"/>
        </ItemGroup>
        <Delete Files="@(FilesToDelete)"/>
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="@(TempZipDirectory)"/>
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="@(TempZipDirectory)"/>
        <ZipDirectory SourceDirectory="@(TempZipDirectory)" DestinationFile="$(BaseOutputPath)Jellyfin.SubtitleCat@v$(Version).zip" Condition="'$(Configuration)'=='Release'"/>
        <ZipDirectory SourceDirectory="@(TempZipDirectory)" DestinationFile="$(BaseOutputPath)Emby.SubtitleCat@v$(Version).zip" Condition="'$(Configuration)'=='Release.Emby'"/>
        <RemoveDir Directories="@(TempZipDirectory)"/>
    </Target>

</Project>
